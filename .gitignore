# Dependencies
node_modules/

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Expo / tooling caches
.expo/

# OS / editor
.DS_Store
*.log
*.swp

# Flutter/Dart build artifacts (apps/mobile/.gitignore also covers these)
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Legacy React Native app (superseded by apps/mobile Flutter)
/mobile/
# Backend build artifacts
**/dist/

# Temporary tooling
**/.temp/
**/.tmp/

# Coverage
**/coverage/
supabase/tests/security/ids.json

# Skills-Agent runtime queue state. Machine-local, written atomically by
# scripts/skills-agent-coordinator.mjs. Committing it would make one machine's
# run history look like shared progress — a fresh clone would start with tasks
# already marked VERIFIED by somebody else's demonstration.
.skills-agent/state.json
.skills-agent/.state.lock
